{
  "name": "@ejam/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./schema": {
      "import": "./src/schema.ts",
      "types": "./src/schema.ts"
    },
    "./paths": {
      "import": "./src/paths.ts",
      "types": "./src/paths.ts"
    },
    "./reader": {
      "import": "./src/reader.ts",
      "types": "./src/reader.ts"
    },
    "./exam-config": {
      "import": "./src/exam-config/index.ts",
      "types": "./src/exam-config/index.ts"
    },
    "./dependency-resolver": {
      "import": "./src/dependency-resolver/index.ts",
      "types": "./src/dependency-resolver/index.ts"
    },
    "./college-predictor": {
      "import": "./src/college-predictor/index.ts",
      "types": "./src/college-predictor/index.ts"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "lint:write": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.2-r.1",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}