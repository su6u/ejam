{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm data:fetch --download && pnpm turbo run build --filter=@ejam/web",
  "framework": "nextjs",
  "functions": {
    "src/app/api/predict/[exam_id]/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
