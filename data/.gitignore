# ejam data lake — ignore rules (see docs/DATA.md)

# Raw scraped sources (regenerable from ejam-ingest)
**/_raw/

# Ingest runtime logs (versioned manifest pins v*.json stay tracked)
manifest/sources.jsonl
manifest/runs.jsonl

# Local / experimental outputs
dist/sandbox/
dist/backtest-results.json

# Release payloads are published as GitHub Release assets.
# Keep manifests and small registry/config metadata in git; keep large data local.
engineering/**/*.parquet
dist/*.parquet
dist/*.lineage.json
