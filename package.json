{
  "name": "ejam",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "validate:data": "uv run --directory packages/data-validation validate-data",
    "generate:manifest": "pnpm --filter @ejam/data-cli generate-manifest",
    "data:fetch": "pnpm --filter @ejam/data-cli run fetch",
    "package:data-release": "pnpm --filter @ejam/data-cli package-data-release",
    "publish:data-release": "pnpm --filter @ejam/data-cli publish-data-release",
    "build:predictor-index": "pnpm --filter @ejam/data-cli build-predictor-index",
    "backtest": "pnpm --filter @ejam/data-cli backtest",
    "build:csab-index": "pnpm --filter @ejam/data-cli build-csab-index",
    "verify:index-lineage": "pnpm --filter @ejam/data-cli verify-index-lineage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "tsx": "^4.21.0",
    "turbo": "^2.9.15",
    "typescript": "^6.0.3"
  }
}
