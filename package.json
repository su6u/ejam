{
  "name": "ejam",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "validate:data": "uv run python scripts/validate_data.py",
    "build:data": "tsx scripts/build-data.ts",
    "generate:manifest": "tsx scripts/generate-manifest.ts",
    "data:fetch": "tsx scripts/fetch-data.ts",
    "package:data-release": "tsx scripts/package-data-release.ts",
    "build:predictor-index": "tsx scripts/build-college-predictor-index.ts",
    "backtest": "tsx scripts/backtest/predictor.ts",
    "build:csab-index": "tsx scripts/build-csab-predictor-index.ts",
    "verify:index-lineage": "tsx scripts/verify-index-lineage.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@duckdb/node-api": "^1.5.2-r.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.8",
    "typescript": "^6.0.3",
    "zod": "^4.4.2"
  }
}
